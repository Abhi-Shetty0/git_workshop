---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games
    .filter((game) => game.category)
    .map((game) => [game.category!.id, game.category!]),
)].map(([, category]) => category).sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games
    .filter((game) => game.publisher)
    .map((game) => [game.publisher!.id, game.publisher!]),
)].map(([, publisher]) => publisher).sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <section
      class="mb-8 rounded-xl border border-slate-700 bg-slate-800/50 p-6"
      aria-labelledby="filter-heading"
      data-testid="game-filters"
    >
      <div class="flex flex-wrap items-center justify-between gap-4">
        <h2 id="filter-heading" class="text-2xl font-medium text-slate-100">Filter games</h2>
        <button
          type="button"
          class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
          data-testid="clear-filters"
        >
          Clear filters
        </button>
      </div>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <fieldset>
          <legend class="mb-3 text-sm font-medium text-slate-200">Categories</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            {categories.map((category) => (
              <label class="flex items-center gap-3 text-slate-300" data-testid={`category-filter-${category.id}`}>
                <input
                  type="checkbox"
                  value={category.id}
                  class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                  data-filter-category
                  aria-label={`Filter by ${category.name}`}
                />
                <span>{category.name}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="publisher-filter" class="mb-3 block text-sm font-medium text-slate-200">Publisher</label>
          <select
            id="publisher-filter"
            class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="publisher-filter"
          >
            <option value="">All publishers</option>
            {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
          </select>
        </div>
      </div>

      <p class="mt-6 text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-results-status">
        Showing {games.length} of {games.length} games.
      </p>
    </section>

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div id="games-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}

      {games.length > 0 && (
        <div hidden data-testid="filtered-empty-state">
          <EmptyState text="No games match the selected filters." />
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterSection = document.querySelector('[data-testid="game-filters"]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const categoryInputs = Array.from(document.querySelectorAll<HTMLInputElement>('[data-filter-category]'));
  const publisherSelect = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const resultStatus = document.querySelector<HTMLElement>('[data-testid="filter-results-status"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  if (filterSection && publisherSelect && clearButton && resultStatus && emptyState) {
    const updateResults = (): void => {
      const selectedCategories = new Set(
        categoryInputs.filter((input) => input.checked).map((input) => input.value),
      );
      const selectedPublisher = publisherSelect.value;
      let visibleCount = 0;

      for (const card of gameCards) {
        const categoryMatches =
          selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
        const isVisible = categoryMatches && publisherMatches;

        card.hidden = !isVisible;
        if (isVisible) {
          visibleCount += 1;
        }
      }

      emptyState.hidden = visibleCount !== 0;
      resultStatus.textContent = `Showing ${visibleCount} of ${gameCards.length} games.`;
    };

    filterSection.addEventListener('change', updateResults);
    clearButton.addEventListener('click', () => {
      for (const input of categoryInputs) {
        input.checked = false;
      }
      publisherSelect.value = '';
      updateResults();
    });
  }
</script>
